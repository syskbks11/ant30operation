OffMode	2
# OFF-Point Coordinate  (RA,Dec)=1 (L,B)=2 (AZ,EL)=3 #
OffCoord	3
# OFF-Point Position [hh/+-dddmmss.s,+-ddmmss.s] #
OffX1_HorD	0
OffX1_Min	0
